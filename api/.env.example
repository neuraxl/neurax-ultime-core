# Copy to .env for direct API development. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://unx2:replace-this-password@localhost:5432/unx2
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# Generate a unique random value of at least 32 characters.
UNX2_API_KEY=replace-with-a-long-random-secret

# Server-side provider credentials. Never put these in frontend variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# One of: openai, claude, gemini. The selected provider performs the arbitration pass.
ARBITER_PROVIDER=openai
PROVIDER_TIMEOUT_SECONDS=45

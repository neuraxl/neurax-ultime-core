# Copy to .env and generate unique random secrets. Never commit .env.
POSTGRES_USER=unx2
POSTGRES_DB=unx2
POSTGRES_PASSWORD=replace-with-a-unique-database-password
UNX2_API_KEY=replace-with-a-random-secret-at-least-32-characters

# Provider credentials are optional individually; configure all three for full comparison.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ARBITER_PROVIDER=openai

API_PORT=8000
MQTT_PORT=1883
ENVIRONMENT=development

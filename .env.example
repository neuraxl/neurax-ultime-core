# Development defaults only. Replace all secrets before deployment.
ENVIRONMENT=development
API_PORT=8000
MQTT_PORT=1883
POSTGRES_DB=unx2
POSTGRES_USER=unx2
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT

# Required for write operations on the Open Source Registry.
# Generate a long random secret; do not commit the real value.
OS_REGISTRY_ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Development defaults only. Replace all secrets before deployment.
ENVIRONMENT=development
API_PORT=8000
MQTT_PORT=1883
POSTGRES_DB=unx2
POSTGRES_USER=unx2
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOYMENT
# Explicit browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
